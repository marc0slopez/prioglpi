# PrioGLPI - configuración de ejemplo
# Copiar como .env y completar valores reales fuera del control de versiones.

APPGLPI_RUNTIME_MODE=production

# Sesiones
AUTH_MODE=local
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
TRUST_PROXY=false
TRUSTED_PROXY_IPS=

# Almacenamiento local heredado, solo mientras se conserva Prisma/SQLite.
DATABASE_URL=file:./data/prioglpi.sqlite

# Base operativa propia de PrioGLPI.
# Usar autenticación integrada del servicio Windows; no declarar usuario ni contraseña SQL.
PRIOGLPI_SQL_SERVER=sql-server.example.local
PRIOGLPI_SQL_PORT=1433
PRIOGLPI_SQL_DATABASE=PrioGLPI
PRIOGLPI_SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
PRIOGLPI_SQL_ENCRYPT=true
PRIOGLPI_SQL_TRUST_SERVER_CERTIFICATE=false
PRIOGLPI_SQL_CONNECTION_TIMEOUT_MS=5000
PRIOGLPI_SQL_REQUEST_TIMEOUT_MS=15000
PRIOGLPI_SQL_POOL_MAX=5

# GLPI
GLPI_API_BASE_URL=https://glpi.example.local/apirest.php
GLPI_BASE_URL=https://glpi.example.local
GLPI_WEB_URL=https://glpi.example.local/
GLPI_APP_TOKEN=REEMPLAZAR
GLPI_USER_TOKEN=REEMPLAZAR
GLPI_TIMEOUT_MS=15000
GLPI_PAGE_SIZE=100
GLPI_MAX_TICKET_PAGES=20
GLPI_ALLOW_SELF_SIGNED=false
GLPI_WRITE_ENABLED=false
GLPI_WRITE_TIMEOUT_MS=15000

# LDAP es una integración opcional futura.
# No incluir hosts, dominios, usuarios ni contraseñas de clientes en este archivo.
# LDAP_URL=
# LDAP_SEARCH_BASE=
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_STARTTLS=true
# LDAP_TLS_REJECT_UNAUTHORIZED=true
